// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s32i = !cir.int<s, 32>

cir.func @duplicate_nsw(%a: !s32i, %b: !s32i) {
  // expected-error@+1 {{duplicate 'nsw' flag}}
  %0 = cir.add nsw nsw %a, %b : !s32i
  cir.return
}

// -----

!s32i = !cir.int<s, 32>

cir.func @duplicate_nuw(%a: !s32i, %b: !s32i) {
  // expected-error@+1 {{duplicate 'nuw' flag}}
  %0 = cir.mul nuw nsw nuw %a, %b : !s32i
  cir.return
}

// -----

!s32i = !cir.int<s, 32>

cir.func @add_nsw_sat(%a: !s32i, %b: !s32i) {
  // expected-error@+1 {{the nsw/nuw flags and the saturated flag are mutually exclusive}}
  %0 = cir.add nsw sat %a, %b : !s32i
  cir.return
}

// -----

!u32i = !cir.int<u, 32>

cir.func @sub_nuw_sat(%a: !u32i, %b: !u32i) {
  // expected-error@+1 {{the nsw/nuw flags and the saturated flag are mutually exclusive}}
  %0 = cir.sub nuw sat %a, %b : !u32i
  cir.return
}

// -----

!s32i = !cir.int<s, 32>

cir.func @unknown_bit(%a: !s32i, %b: !s32i) {
  // expected-error@+1 {{property 'overflow_flags' failed to satisfy constraint: integer overflow flags}}
  %0 = "cir.add"(%a, %b) <{overflow_flags = 4 : i32, saturated = false}> : (!s32i, !s32i) -> !s32i
  cir.return
}
