// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s -check-prefix=MLIR
// RUN: cir-translate %s -cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering | FileCheck %s -check-prefix=LLVM

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>

// Both flags must survive lowering together.

module {
  cir.func @add(%a: !s32i, %b: !s32i) -> !s32i {
    %0 = cir.add nsw nuw %a, %b : !s32i
    cir.return %0 : !s32i
  }
  // MLIR-LABEL: llvm.func @add
  // MLIR: llvm.add %{{.*}}, %{{.*}} overflow<nsw, nuw> : i32
  // LLVM-LABEL: define {{.*}}@add(
  // LLVM: add nuw nsw i32

  cir.func @sub(%a: !u32i, %b: !u32i) -> !u32i {
    %0 = cir.sub nsw nuw %a, %b : !u32i
    cir.return %0 : !u32i
  }
  // MLIR-LABEL: llvm.func @sub
  // MLIR: llvm.sub %{{.*}}, %{{.*}} overflow<nsw, nuw> : i32
  // LLVM-LABEL: define {{.*}}@sub(
  // LLVM: sub nuw nsw i32

  cir.func @mul(%a: !s32i, %b: !s32i) -> !s32i {
    %0 = cir.mul nsw nuw %a, %b : !s32i
    cir.return %0 : !s32i
  }
  // MLIR-LABEL: llvm.func @mul
  // MLIR: llvm.mul %{{.*}}, %{{.*}} overflow<nsw, nuw> : i32
  // LLVM-LABEL: define {{.*}}@mul(
  // LLVM: mul nuw nsw i32

  cir.func @vec_add(%a: !cir.vector<4 x !s32i>, %b: !cir.vector<4 x !s32i>) -> !cir.vector<4 x !s32i> {
    %0 = cir.add nsw nuw %a, %b : !cir.vector<4 x !s32i>
    cir.return %0 : !cir.vector<4 x !s32i>
  }
  // MLIR-LABEL: llvm.func @vec_add
  // MLIR: llvm.add %{{.*}}, %{{.*}} overflow<nsw, nuw> : vector<4xi32>
  // LLVM-LABEL: define {{.*}}@vec_add(
  // LLVM: add nuw nsw <4 x i32>

  cir.func @matrix_mul(%a: !cir.matrix<2 x 3 x !s32i>, %b: !cir.matrix<2 x 3 x !s32i>) -> !cir.matrix<2 x 3 x !s32i> {
    %0 = cir.mul nsw nuw %a, %b : !cir.matrix<2 x 3 x !s32i>
    cir.return %0 : !cir.matrix<2 x 3 x !s32i>
  }
  // MLIR-LABEL: llvm.func @matrix_mul
  // MLIR: llvm.mul %{{.*}}, %{{.*}} overflow<nsw, nuw> : vector<6xi32>
  // LLVM-LABEL: define {{.*}}@matrix_mul(
  // LLVM: mul nuw nsw <6 x i32>
}
